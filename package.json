{
  "name": "caniname",
  "version": "1.0.0",
  "description": "CLI tool to check project name availability across Netlify, NPM, and more.",
  "type": "module",
  "bin": {
    "caniname": "./bin/caniname.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "start": "node ./bin/caniname.js",
    "dev": "npx -y serve website",
    "deploy": "netlify deploy --dir=website --prod",
    "deploy:preview": "netlify deploy --dir=website",
    "test": "node --test"
  },
  "keywords": [
    "caniname",
    "namecheck",
    "availability",
    "npm",
    "netlify",
    "cli"
  ],
  "author": {
    "name": "Bramus Van Damme",
    "email": "bramus@bram.us",
    "url": "https://www.bram.us/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bramus/caniname.git"
  },
  "bugs": {
    "url": "https://github.com/bramus/caniname/issues"
  },
  "homepage": "https://github.com/bramus/caniname#readme",
  "engines": {
    "node": ">=20.12.0"
  }
}
